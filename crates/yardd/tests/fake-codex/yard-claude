#!/usr/bin/env bun
// A scripted stand-in for the Claude sidecar (sidecar/yard-claude), for the
// tests that need a Claude session. Same JSON lines as the real one, no SDK
// and no model. A turn's behaviour is picked by a marker in the prompt:
//   [die]   the sidecar exits at once, as when Claude Code is killed
//   [stuck] streams one chunk, then ignores interrupts
//   [steps] three Bash tool calls, 400 ms apart, then "Echo: <prompt>";
//           user messages that arrive meanwhile are folded into the same
//           turn, as Claude Code does, and appended as " | also: …"
//   [subagent] a Task call with a subagent of its own: the call, two nested
//           steps of the subagent (events carry `parent`), the subagent's
//           result with its duration (`ms`), then "Echo: <prompt>". It also
//           leaves a `sleep 30` running under the sidecar, so a session's
//           process list has something to show.
//   [subagents] three subagents side by side, as a planner fans out: a long
//           title, two still running with a long latest command for 30 s,
//           then all done and "Echo: <prompt>"
//   [background-agent] an Agent call run in the background, as Claude does by
//           default: the turn answers and completes at once, and the
//           subagent reports 1.5 s later (its `tool_completed` after the turn)
//   [background-agents] the owner's shape: a command, two background Agent
//           calls, a message between steps, then the turn completes; the
//           two keep taking steps (`parent`) and report 20 s later
//   [wakeup] / [cron] / [cron-delete]  a ScheduleWakeup / CronCreate /
//           CronDelete call, labelled by the real sidecar's toolStarted (so it
//           carries `keepsAlive` / `endsCron`), then "Echo: <prompt>"
//   [chart] an MCP call to `chart` (verify/fakes/mcp-chart) that ends with
//           its widget on `tool_completed` (`app`), then "Here is the chart."
//   [[tool NAME {json}]]  calls Switchyard's agent tool NAME through the
//           server `start` gave (`tools`, the SDK's `mcpServers` entry; see
//           agent-tools.mjs), labelled as the real sidecar labels it, then
//           "Called NAME: <result>" per call
//   other   replies "Echo: <prompt>"
// A widget's calls (`mcp_call`) go to mcp-chart: a read-only tool runs, any
// other is refused as Claude Code's permission check would without an answer.
// `mcp_reconnect` is logged (`reconnect <server>`).
//
// `connectors <cwd>` (see sidecar/yard-claude/src/connectors.ts) lists four
// servers: `claude.ai Datadog` (needs sign-in on claude.ai; a sign-in
// completes by itself 1 s later), `plugin:engineering:sentry` (needs sign-in;
// completes when its callback address with `code=` is pasted), `chart`
// (connected, two widget tools) and a failed `plugin:engineering:gmail`.
// Sign-ins are kept in FAKE_CODEX_DIR (or CLAUDE_CONFIG_DIR) as files.
// Servers added with the fake `claude mcp add` (claude-mcp.txt there) are
// listed too, needing sign-in until a pasted address with `code=` arrives.
// Each start also reports plan usage (47% of 5 hours, 17% of the week, Sonnet 8%;
// 91% of 5 hours when CLAUDE_CONFIG_DIR names an extra account).
// FAKE_CODEX_DIR gets `sidecar.log`: one line per start, with its resume id,
// CLAUDE_CONFIG_DIR (`config=`, empty for the default account) and the
// session's connector scope when it has one (`mcp=only:a,b` / `mcp=except:a`),
// one per turn with the permission mode yardd named for it (`turn permission=plan`),
// and one per one-shot `sessions` / `messages <id>` call.
//
// `usage` answers the plan limits the real one reads from Claude Code's usage
// report, without a turn: 47% of 5 hours and 17% of the week, or 91% / 40%
// when CLAUDE_CONFIG_DIR names an extra account. Logged as `usage config=…`.
//
// One-shot modes, like the real sidecar's, for importing Claude Code sessions:
//   sessions        three TEST- sessions: two in FAKE_CLAUDE_CWD (else HOME),
//                   one whose folder no longer exists
//   messages <id>   that session's history as yardd events

import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { CHART_URI, chartCall, rpc } from "./chart.mjs";
import { afterCalls, callTools, toolMarkers } from "./agent-tools.mjs";
import { describe as describeTool, toolStarted } from "../../../../sidecar/yard-claude/src/tools.ts";

// The connector scope `start` gave (see sidecar/yard-claude/src/scope.ts), for the log.
const mcpScope = (m) => (m?.only ? ` mcp=only:${m.only.join(",")}` : m?.except ? ` mcp=except:${m.except.join(",")}` : "");

// An agent's session hands the engine a preamble, then the user's message.
// Only what the user typed controls the scripted behaviour.
const AGENT_MARK = "\nThe user's message:\n";
const typed = (text) => (text.includes(AGENT_MARK) ? text.slice(text.lastIndexOf(AGENT_MARK) + AGENT_MARK.length) : text);

const dir = process.env.FAKE_CODEX_DIR;
const log = (line) => {
  if (dir) appendFileSync(`${dir}/sidecar.log`, `${line}\n`);
};
const out = (msg) => process.stdout.write(JSON.stringify(msg) + "\n");
const emit = (event) => out({ type: "event", event });

const mode = process.argv[2];
if (mode === "usage") {
  log(`usage config=${process.env.CLAUDE_CONFIG_DIR ?? ""}`);
  const at = (s) => Math.floor(Date.now() / 1000) + s;
  const extra = !!process.env.CLAUDE_CONFIG_DIR;
  out({
    usage: {
      windows: {
        five_hour: { utilization: extra ? 0.91 : 0.47, resetsAt: at(2 * 3600) },
        seven_day: { utilization: extra ? 0.4 : 0.17, resetsAt: at(3 * 86400) },
      },
    },
  });
  process.exit(0);
}
if (mode === "sessions" || mode === "messages") {
  log(`${mode} ${process.argv[3] ?? ""}`.trim());
  const cwd = process.env.FAKE_CLAUDE_CWD || process.env.HOME || "/";
  const hour = 3600_000;
  const now = Date.now();
  const sessions = [
    { sessionId: "11111111-1111-4111-8111-111111111111", title: "TEST-fix the login redirect", cwd, gitBranch: "main", lastModified: now - 5 * 60_000, createdAt: now - 2 * hour },
    { sessionId: "22222222-2222-4222-8222-222222222222", title: "TEST-write the release notes", cwd: "/nonexistent/TEST-gone", gitBranch: null, lastModified: now - 5 * hour, createdAt: now - 6 * hour },
    { sessionId: "33333333-3333-4333-8333-333333333333", title: "TEST-old refactor of the parser", cwd, gitBranch: "parser", lastModified: now - 72 * hour, createdAt: now - 80 * hour },
  ];
  if (mode === "sessions") {
    out({ sessions });
    process.exit(0);
  }
  const session = sessions.find((s) => s.sessionId === process.argv[3]);
  if (!session) {
    out({ error: `no Claude Code session ${process.argv[3]}` });
    process.exit(1);
  }
  const t = session.title;
  out({
    session,
    events: [
      { type: "user_message", text: t },
      { type: "turn_started" },
      { type: "tool_started", itemId: "imp-1", kind: "read", title: "Read", detail: "src/login.ts" },
      { type: "tool_completed", itemId: "imp-1", ok: true, output: "export function login() {}" },
      { type: "assistant_message", itemId: "imp-2", text: `TEST-answer to: ${t}` },
      { type: "turn_completed", status: "completed" },
      { type: "user_message", text: "TEST-and add a test" },
      { type: "turn_started" },
      { type: "assistant_message", itemId: "imp-3", text: "TEST-added login.test.ts." },
      { type: "turn_completed", status: "completed" },
    ],
  });
  process.exit(0);
}

if (mode === "connectors") {
  const store = process.env.CLAUDE_CONFIG_DIR || dir || "/tmp";
  const ok = (name) => existsSync(`${store}/mcp-ok-${name}`);
  const mark = (name) => writeFileSync(`${store}/mcp-ok-${name}`, "");
  log(`connectors pid=${process.pid} cwd=${process.argv[3] ?? ""} config=${process.env.CLAUDE_CONFIG_DIR ?? ""}`);
  const added = () =>
    (existsSync(`${store}/claude-mcp.txt`) ? readFileSync(`${store}/claude-mcp.txt`, "utf8") : "")
      .split("\n")
      .filter(Boolean)
      .map((l) => ({ name: l.split(" ")[0], url: l.split(" ")[1] }));
  const status = async () => {
    const { tools } = await rpc("tools/list");
    const extra = added().map((a) => ({
      name: a.name,
      status: ok(a.name) ? "connected" : "needs-auth",
      source: "user",
      tools: ok(a.name) ? 5 : 0,
      appTools: 0,
      origin: new URL(a.url).origin,
    }));
    return [
      ...extra,
      { name: "claude.ai Datadog", status: ok("datadog") ? "connected" : "needs-auth", source: "claudeai", tools: ok("datadog") ? 12 : 0, appTools: 0, origin: "https://mcp-proxy.anthropic.com" },
      { name: "plugin:engineering:sentry", status: ok("sentry") ? "connected" : "needs-auth", source: "plugin", tools: ok("sentry") ? 9 : 0, appTools: 0, origin: "https://mcp.sentry.dev" },
      { name: "chart", status: "connected", source: "user", tools: tools.length, appTools: tools.filter((t) => t._meta?.ui?.resourceUri).length },
      { name: "plugin:engineering:gmail", status: "failed", source: "plugin", tools: 0, appTools: 0, error: "No URL configured for this server" },
    ];
  };
  for await (const line of console) {
    let msg;
    try {
      msg = JSON.parse(line);
    } catch {
      continue;
    }
    log(`connectors ${msg.type}${msg.server ? ` ${msg.server}` : ""}`);
    const answer = (result) => out({ id: msg.id, ok: true, result });
    const refuse = (error) => out({ id: msg.id, ok: false, error });
    if (msg.type === "status") answer(await status());
    else if (msg.type === "auth" && msg.server === "claude.ai Datadog") {
      answer({ url: "https://claude.ai/fake-connect/datadog", paste: false });
      setTimeout(() => {
        mark("datadog");
        out({ type: "auth_done", server: msg.server, ok: true });
      }, 1000);
    } else if (msg.type === "auth" && msg.server === "plugin:engineering:sentry") {
      answer({ url: "https://sentry.example/oauth/authorize?redirect_uri=http%3A%2F%2Flocalhost%3A39999%2Fcallback", paste: true });
    } else if (msg.type === "auth" && added().some((a) => a.name === msg.server)) {
      answer({ url: `https://auth.example.com/${msg.server}/authorize?redirect_uri=http%3A%2F%2Flocalhost%3A39998%2Fcallback`, paste: true });
    } else if (msg.type === "auth") refuse(`Server type "stdio" does not support OAuth authentication`);
    else if (msg.type === "callback") {
      if (!String(msg.url).includes("code=")) refuse("Invalid callback URL: missing authorization code. Please paste the full redirect URL including the code parameter.");
      else {
        mark(msg.server === "plugin:engineering:sentry" ? "sentry" : msg.server);
        answer({ done: true });
      }
    } else if (msg.type === "reconnect") answer({ done: true });
    else refuse(`unknown request ${msg.type}`);
  }
  process.exit(0);
}

async function runChart(text) {
  const id = `tool-${process.pid}-${++n}`;
  const input = { metric: "p95 latency", points: 8 };
  emit({ type: "tool_started", itemId: id, kind: "other", title: "show_chart", detail: `chart · ${JSON.stringify(input)}` });
  const { result, html, ui } = await chartCall(input);
  emit({
    type: "tool_completed",
    itemId: id,
    ok: true,
    output: result.content[0].text,
    app: { server: "chart", tool: "show_chart", uri: CHART_URI, html, csp: ui.csp, prefersBorder: ui.prefersBorder, input, result },
  });
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: "Here is the chart." });
  emit({ type: "turn_completed", status: "completed" });
}

let n = 0;
let stuck = false;
// Switchyard's tools server, when `start` gave one (an agent's conversation).
let tools = null;

async function runTools(calls) {
  const ids = calls.map((c) => {
    const id = `tool-${process.pid}-${++n}`;
    const name = `mcp__switchyard__${c.tool}`;
    const d = describeTool(name, c.args, "/");
    emit({ type: "tool_started", itemId: id, kind: d.kind, title: d.title, detail: d.detail });
    return id;
  });
  const results = await callTools(tools, calls);
  results.forEach((r, i) => emit({ type: "tool_completed", itemId: ids[i], ok: !r.isError, output: r.text }));
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: afterCalls(results) });
  emit({ type: "turn_completed", status: "completed" });
}
// A [steps] turn in progress: messages that arrive are folded into it.
let steps = null;

async function runSteps(text) {
  steps = { folded: [], interrupted: false };
  for (let i = 1; i <= 3; i++) {
    const id = `tool-${process.pid}-${++n}`;
    emit({ type: "tool_started", itemId: id, kind: "command", title: "Bash", detail: `echo step ${i}` });
    await new Promise((r) => setTimeout(r, 400));
    emit({ type: "tool_completed", itemId: id, ok: true, output: `step ${i}` });
    if (steps.interrupted) {
      steps = null;
      emit({ type: "turn_completed", status: "interrupted" });
      return;
    }
  }
  const also = steps.folded.length ? ` | also: ${steps.folded.join(" / ")}` : "";
  steps = null;
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: `Echo: ${text}${also}` });
  emit({ type: "turn_completed", status: "completed" });
}
let sleeper = null;
async function runBackgroundAgent(text) {
  const id = `tool-${process.pid}-${++n}`;
  emit({ type: "tool_started", itemId: id, kind: "other", title: "Agent", detail: "TEST-work in the background", agent: "general-purpose" });
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: `Echo: ${text}` });
  emit({ type: "turn_completed", status: "completed" });
  await new Promise((r) => setTimeout(r, 1500));
  emit({ type: "tool_completed", itemId: id, ok: true, output: "TEST-background report", ms: 1500 });
}

async function runBackgroundAgents(text) {
  const pause = (ms) => new Promise((r) => setTimeout(r, ms));
  const step = (kind, title, detail, parent) => {
    const id = `tool-${process.pid}-${++n}`;
    emit({ type: "tool_started", itemId: id, kind, title, detail, ...(parent ? { parent } : {}) });
    emit({ type: "tool_completed", itemId: id, ok: true, output: `${detail} done` });
  };
  step("command", "Ran", "free -h");
  const agents = ["TEST-read the agents' conversations", "TEST-measure memory pressure"].map((detail) => ({ id: `tool-${process.pid}-${++n}`, detail }));
  for (const a of agents) emit({ type: "tool_started", itemId: a.id, kind: "other", title: "Agent", detail: a.detail, agent: "general-purpose" });
  step("command", "Ran", "gh pr list");
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: "Meanwhile I'll review the PRs." });
  step("command", "Ran", "git diff");
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: `Echo: ${text}` });
  emit({ type: "turn_completed", status: "completed" });
  for (let i = 0; i < 4; i++) {
    await pause(5000);
    for (const a of agents) step("command", "Ran", `TEST-step ${i + 1}`, a.id);
  }
  for (const a of agents) emit({ type: "tool_completed", itemId: a.id, ok: true, output: `${a.detail}: report`, ms: 20000 });
}

async function runSubagents(text) {
  const pause = (ms) => new Promise((r) => setTimeout(r, ms));
  const agents = [
    ["TEST-build agent tools (needs-you, agent messaging, memory) and prove each one on the scripted engines", "cd /tmp/TEST-worktrees/agent-tools && CARGO_BUILD_JOBS=2 cargo test -p yardd --test agents -- --nocapture"],
    ["TEST-per-agent accounts and remote agents", "grep -rn \"context request timed out\\|during context\" crates/yardd/src"],
    ["TEST-Slack connector", "cd /tmp/TEST-worktrees/agents-slack && bun test ui/src/slack.test.ts"],
  ].map(([detail, command]) => ({ id: `tool-${process.pid}-${++n}`, detail, command }));
  for (const a of agents) emit({ type: "tool_started", itemId: a.id, kind: "other", title: "Agent", detail: a.detail, agent: "general-purpose" });
  for (const a of agents) {
    for (const [kind, title, detail] of [["read", "Read", "README.md"], ["command", "Bash", a.command]]) {
      const id = `tool-${process.pid}-${++n}`;
      await pause(150);
      emit({ type: "tool_started", itemId: id, parent: a.id, kind, title, detail });
      if (kind === "read") emit({ type: "tool_completed", itemId: id, ok: true, output: `${title} done` });
    }
  }
  emit({ type: "tool_completed", itemId: agents[2].id, ok: true, output: "TEST-subagents report: Slack done", ms: 900 });
  await pause(30000);
  for (const a of agents.slice(0, 2)) emit({ type: "tool_completed", itemId: a.id, ok: true, output: "TEST-subagents report: done", ms: 6900 });
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: `Echo: ${text}` });
  emit({ type: "turn_completed", status: "completed" });
}

async function runSubagent(text) {
  // A background process, as `npm run dev &` would be. Ends on its own after 30 s.
  if (!sleeper) {
    sleeper = Bun.spawn(["sleep", "30"], { stdout: "ignore", stderr: "ignore" });
  }
  const agent = `tool-${process.pid}-${++n}`;
  const pause = (ms) => new Promise((r) => setTimeout(r, ms));
  emit({ type: "tool_started", itemId: agent, kind: "other", title: "Agent", detail: "TEST-survey the repo", agent: "general-purpose" });
  for (const [kind, title, detail] of [["read", "Read", "README.md"], ["command", "Bash", "ls src"]]) {
    const id = `tool-${process.pid}-${++n}`;
    await pause(400);
    emit({ type: "tool_started", itemId: id, parent: agent, kind, title, detail });
    await pause(400);
    emit({ type: "tool_completed", itemId: id, ok: true, output: `${title} done` });
  }
  emit({ type: "tool_completed", itemId: agent, ok: true, output: "TEST-subagent report: two files read", ms: 1700 });
  emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: `Echo: ${text}` });
  emit({ type: "turn_completed", status: "completed" });
}
for await (const line of console) {
  let msg;
  try {
    msg = JSON.parse(line);
  } catch {
    continue;
  }
  if (msg.type === "start") {
    log(`start pid=${process.pid} config=${process.env.CLAUDE_CONFIG_DIR ?? ""} resume=${msg.resume ?? ""}${msg.restricted ? " restricted=true" : ""}${msg.tools ? " tools=switchyard" : ""}${mcpScope(msg.mcp)}`);
    tools = msg.tools ?? null;
    out({ type: "session", claudeSessionId: msg.resume ?? `fake-claude-${process.pid}` });
    // The shape the real sidecar sends (sidecar/yard-claude/src/usage.ts):
    // utilization is a fraction, resetsAt epoch seconds.
    const at = (s) => Math.floor(Date.now() / 1000) + s;
    out({
      type: "usage",
      usage: {
        status: "allowed",
        windows: {
          five_hour: { utilization: process.env.CLAUDE_CONFIG_DIR ? 0.91 : 0.47, resetsAt: at(1 * 3600 + 35 * 60 + 30) },
          seven_day: { utilization: 0.17, resetsAt: at(4 * 86400 + 2 * 3600 + 30) },
          seven_day_sonnet: { utilization: 0.08, resetsAt: at(4 * 86400 + 2 * 3600 + 30) },
        },
      },
    });
  } else if (msg.type === "user" && steps) {
    log(`fold ${String(msg.text ?? "").slice(0, 80)}`);
    steps.folded.push(String(msg.text ?? ""));
  } else if (msg.type === "user") {
    const text = String(msg.text ?? "");
    if (msg.permission) log(`turn permission=${msg.permission}`);
    // Session naming, before any marker: its prompt quotes the conversation.
    // Claude is the fallback, so it answers a title for "[name-fail]" (Codex failed it).
    if (text.startsWith("Name this coding session")) {
      emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: text.includes("[name-fail]") ? "Claude named session" : "" });
      emit({ type: "turn_completed", status: "completed" });
      continue;
    }
    const behaviorText = typed(text);
    const calls = toolMarkers(behaviorText);
    if (calls.length) {
      runTools(calls);
      continue;
    }
    if (behaviorText.includes("[steps]")) {
      runSteps(text);
      continue;
    }
    if (behaviorText.includes("[chart]")) {
      runChart(text);
      continue;
    }
    if (behaviorText.includes("[background-agents]")) {
      runBackgroundAgents(text);
      continue;
    }
    if (behaviorText.includes("[background-agent]")) {
      runBackgroundAgent(text);
      continue;
    }
    if (behaviorText.includes("[subagents]")) {
      runSubagents(text);
      continue;
    }
    if (behaviorText.includes("[subagent]")) {
      runSubagent(text);
      continue;
    }
    // A tool that leaves work in the process after the turn, flagged as the
    // real sidecar flags it (`keepsAlive`, `endsCron`).
    const keeper = { "[wakeup]": ["ScheduleWakeup", { delaySeconds: 600, prompt: "check again" }], "[cron]": ["CronCreate", { cron: "*/5 * * * *", prompt: "poll" }], "[cron-delete]": ["CronDelete", { id: "c1" }] };
    const kept = Object.keys(keeper).find((k) => behaviorText.includes(k));
    if (kept) {
      const [name, input] = keeper[kept];
      const id = `keep-${process.pid}-${++n}`;
      emit(toolStarted({ id, name, input }, process.cwd()));
      emit({ type: "tool_completed", itemId: id, ok: true, output: "scheduled" });
      emit({ type: "assistant_message", itemId: `text-${process.pid}-${++n}`, text: `Echo: ${typed(text)}` });
      emit({ type: "turn_completed", status: "completed" });
      continue;
    }
    if (behaviorText.includes("[die]")) process.exit(1);
    const itemId = `text-${process.pid}-${++n}`;
    if (behaviorText.includes("[stuck]")) {
      stuck = true;
      emit({ type: "assistant_delta", itemId, text: "Stuck" });
      continue;
    }
    emit({ type: "assistant_message", itemId, text: `Echo: ${typed(text)}` });
    emit({ type: "turn_completed", status: "completed" });
  } else if (msg.type === "mcp_reconnect") {
    log(`reconnect ${msg.server}`);
  } else if (msg.type === "mcp_call") {
    log(`mcp_call ${msg.server} ${msg.tool}`);
    const { tools } = await rpc("tools/list");
    const tool = msg.server === "chart" ? tools.find((t) => t.name === msg.tool) : null;
    if (!tool) out({ type: "reply", ref: msg.ref, error: `${msg.server} has no tool ${msg.tool}` });
    else if (!tool.annotations?.readOnlyHint) out({ type: "reply", ref: msg.ref, error: `The tool did not run: Claude requested permissions to use ${msg.tool}, but you haven't granted it yet.` });
    else out({ type: "reply", ref: msg.ref, result: await rpc("tools/call", { name: msg.tool, arguments: msg.arguments ?? {} }) });
  } else if (msg.type === "interrupt" && steps) {
    steps.interrupted = true;
  } else if (msg.type === "interrupt" && !stuck) {
    emit({ type: "turn_completed", status: "interrupted" });
  }
}
