#!/usr/bin/env bun
// A scripted stand-in for `codex app-server`, for yardd's integration tests.
// Tests put this folder first on PATH, so yardd runs it instead of the real
// CLI and no turn ever reaches a model.
//
// A turn's behaviour is picked by a marker in the prompt:
//   [cmd]   a command that needs approval, then runs or is declined; after
//           an allowed run it waits 400 ms, and names steered input
//           (turn/steer) in its answer
//   [edit]  a file change with a diff (also written to disk when
//           FAKE_CODEX_WRITE is set, as verify/yv's isolated environments do,
//           so the Changes pane has a real git diff to show)
//   [slow]  streams one chunk, then waits for turn/interrupt
//   [stuck] streams one chunk, then never ends, whatever it is asked
//   [context] fails as a thread whose context window is full
//   [fail]  the turn fails with an error
//   [think] a two-part reasoning summary, then a reply
//   [tail]  one command, then 1 s of thinking before "Echo: <prompt>":
//           a message sent in that second has no step left to join
//   [steps] three commands, 400 ms apart, then "Echo: <prompt>"; input
//           steered in meanwhile (turn/steer) is appended as " | steered: …"
//   [chart] an MCP call to the `chart` server (verify/fakes/mcp-chart) whose
//           tool declares a widget (`mcpAppUi`), then "Here is the chart."
//   [[tool NAME {json}]]  calls Switchyard's agent tool NAME through the
//           server the thread was given (`mcp_servers.switchyard` in
//           thread/start or thread/resume `config`; see agent-tools.mjs), as
//           `mcpToolCall` items, then "Called NAME: <result>" per call
//
// MCP: `mcpServerStatus/list` lists `chart` (connected, from mcp-chart) and
// `fake-oauth` (not logged in until its sign-in completes); `app/list` one
// ChatGPT app that is not connected. `mcpServer/oauth/login` answers with a
// sign-in link whose redirect is a real loopback page on this host: a GET of
// /callback?code=… there completes it (`mcpServer/oauthLogin/completed`).
// `mcpServer/resource/read` and `mcpServer/tool/call` go to mcp-chart.
//   other   a plain streamed reply: "Echo: <prompt>"
//
// CODEX_HOME (set for an extra account) moves the login state and the thread
// list into that folder, makes the account's email `<folder name>@example.com`
// and its usage 77% (12% otherwise), and is named on the `start` log line and
// in every turn-inputs.jsonl row, so a test can tell which account ran a turn.
//
// FAKE_CODEX_DIR (set by the tests) gets `codex.log`, one line per start and
// per request, `turn-inputs.jsonl` with the input items of every turn/start,
// and `threads.json`, so a restarted fake can resume a thread the previous
// one started, and refuses one it never saw.

import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { CHART_URI, chartCall, rpc } from "./chart.mjs";
import { afterCalls, callTools, toolMarkers } from "./agent-tools.mjs";

const dir = process.env.FAKE_CODEX_DIR;
const log = (line) => {
  if (dir) appendFileSync(`${dir}/codex.log`, `${line}\n`);
};

const home = process.env.CODEX_HOME || "";
const state = home || dir;
log(`start pid=${process.pid} args=${process.argv.slice(2).join(" ")} home=${home}`);
// Servers written with `config/value/write` (`mcp_servers.<name>`): "name
// url" lines in codex-mcp.txt in the state folder, listed like fake-oauth.
const mcpFile = `${state || "/nonexistent"}/codex-mcp.txt`;
const addedServers = () =>
  (existsSync(mcpFile) ? readFileSync(mcpFile, "utf8") : "")
    .split("\n")
    .filter(Boolean)
    .map((l) => ({ name: l.split(" ")[0], url: l.split(" ")[1] }));
const saveServers = (list) => {
  if (home) mkdirSync(home, { recursive: true });
  writeFileSync(mcpFile, list.map((a) => `${a.name} ${a.url}\n`).join(""));
};
if (process.argv[2] !== "app-server") {
  console.error("fake codex: only `app-server` is implemented");
  process.exit(2);
}

const threadsFile = state ? `${state}/threads.json` : null;
const threads = new Map(
  threadsFile && existsSync(threadsFile) ? JSON.parse(readFileSync(threadsFile, "utf8")) : [],
);
const saveThreads = () => {
  if (home) mkdirSync(home, { recursive: true });
  if (threadsFile) writeFileSync(threadsFile, JSON.stringify([...threads]));
};

let counter = 0;
const newId = (prefix) => `${prefix}-${process.pid}-${++counter}`;

const write = (msg) => process.stdout.write(`${JSON.stringify(msg)}\n`);
const notify = (method, params) => write({ method, params });

// Server-to-client requests (approvals) waiting for the client's answer.
let nextServerId = 1000;
const waiting = new Map();
const ask = (method, params) =>
  new Promise((resolve) => {
    const id = nextServerId++;
    waiting.set(id, resolve);
    write({ id, method, params });
  });

// Running turns, by turn id: whether each was interrupted, and how to wake a slow one.
const running = new Map();

const MODELS = [
  {
    id: "fake-fast",
    model: "fake-fast",
    displayName: "Fake Fast",
    description: "Scripted test model",
    hidden: false,
    isDefault: true,
    defaultReasoningEffort: "low",
    serviceTiers: [
      { id: "priority", name: "Fast", description: "Higher speed, increased usage" },
      { id: "ultrafast", name: "Ultrafast", description: "Fastest available responses" },
    ],
    supportedReasoningEfforts: [
      { reasoningEffort: "low", description: "Quick" },
      { reasoningEffort: "high", description: "Careful" },
    ],
  },
  {
    id: "fake-deep",
    model: "fake-deep",
    displayName: "Fake Deep",
    description: "Second scripted test model",
    hidden: false,
    isDefault: false,
    defaultReasoningEffort: "medium",
    supportedReasoningEfforts: [
      { reasoningEffort: "medium", description: "Balanced" },
      { reasoningEffort: "xhigh", description: "Thorough" },
    ],
  },
];

if (process.env.YARD_TEST_CODEX_LONG_CATALOG === "1") {
  const template = MODELS[1];
  for (let i = 1; i <= 8; i++) {
    const id = `fake-option-${i}`;
    MODELS.push({ ...template, id, model: id, displayName: `Fake Option ${i}` });
  }
}

const threadInfo = (id, cwd) => ({
  id,
  cwd,
  preview: "",
  ephemeral: false,
  modelProvider: "fake",
  createdAt: 0,
  updatedAt: 0,
  status: { type: "idle" },
  turns: [],
});

const threadResponse = (id, p) => ({
  thread: threadInfo(id, p.cwd ?? threads.get(id)?.cwd ?? ""),
  model: p.model ?? "fake-fast",
  modelProvider: "fake",
  cwd: p.cwd ?? threads.get(id)?.cwd ?? "",
  approvalPolicy: p.approvalPolicy ?? "on-request",
  approvalsReviewer: "user",
  sandbox: { type: "workspaceWrite" },
});

async function handle(msg) {
  const { id, method, params: p = {} } = msg;
  const reply = (result) => write({ id, result });
  const fail = (message) => write({ id, error: { code: -32600, message } });
  const policy = p.approvalPolicy && method === "turn/start" ? ` approval=${p.approvalPolicy} sandboxPolicy=${p.sandboxPolicy?.type}` : "";
  log(`req ${method}${p.threadId ? ` ${p.threadId}` : ""}${p.sandbox ? ` sandbox=${p.sandbox}` : ""}${policy}`);

  switch (method) {
    case "initialize":
      return reply({ userAgent: "fake-codex/0", codexHome: "/nonexistent", platformFamily: "unix", platformOs: "macos" });
    case "model/list":
      return reply({ data: MODELS, nextCursor: null });
    case "account/rateLimits/read":
      return reply({
        rateLimits: {
          limitId: "codex",
          // Reset times are epoch seconds, as the real app-server sends them.
          primary: { usedPercent: home ? 77 : 12, windowDurationMins: 300, resetsAt: Math.floor(Date.now() / 1000) + 2 * 3600 + 10 * 60 + 30 },
          secondary: { usedPercent: 34, windowDurationMins: 10080, resetsAt: Math.floor(Date.now() / 1000) + 3 * 86400 + 4 * 3600 + 30 },
        },
      });
    // Logged out until a device-code login completes; the state outlives a restart.
    case "account/read": {
      const loggedIn = state && existsSync(`${state}/codex-logged-in`);
      const email = home ? `${home.split("/").filter(Boolean).pop()}@example.com` : "me@example.com";
      return reply({ account: loggedIn ? { type: "chatgpt", email, planType: "pro" } : null, requiresOpenaiAuth: true });
    }
    case "account/login/start": {
      if (p.type !== "chatgptDeviceCode") return fail(`fake codex: login type ${p.type}`);
      const loginId = newId("login");
      reply({ type: "chatgptDeviceCode", loginId, userCode: "FAKE-1234", verificationUrl: "https://auth.openai.com/codex/device" });
      setTimeout(() => {
        if (state) {
          if (home) mkdirSync(home, { recursive: true });
          writeFileSync(`${state}/codex-logged-in`, "");
        }
        notify("account/login/completed", { loginId, success: true, error: null });
      }, 300);
      return;
    }
    case "thread/start": {
      if (dir) appendFileSync(`${dir}/thread-starts.jsonl`, `${JSON.stringify(p)}\n`);
      // Codex converts JSON null to an empty TOML string, which is invalid for numeric timeouts.
      for (const [name, server] of Object.entries(p.config?.mcp_servers ?? {})) {
        if (server.tool_timeout_sec === null) return fail(`invalid type: string "", expected f64 in mcp_servers.${name}.tool_timeout_sec`);
      }
      const tid = newId("thread");
      threads.set(tid, { cwd: p.cwd ?? "", tools: p.config?.["mcp_servers.switchyard"] ?? null });
      saveThreads();
      return reply(threadResponse(tid, p));
    }
    case "thread/resume": {
      if (!threads.has(p.threadId)) return fail(`no such thread: ${p.threadId}`);
      // A resumed thread's servers are the ones it is resumed with.
      threads.get(p.threadId).tools = p.config?.["mcp_servers.switchyard"] ?? null;
      saveThreads();
      return reply(threadResponse(p.threadId, p));
    }
    case "turn/start": {
      const thread = threads.get(p.threadId);
      if (!thread) return fail(`no such thread: ${p.threadId}`);
      // Every input item, so tests can check what reached the engine.
      if (dir) appendFileSync(`${dir}/turn-inputs.jsonl`, `${JSON.stringify({ threadId: p.threadId, input: p.input, home, serviceTierForTurn: p.serviceTierForTurn })}\n`);
      const text = (p.input ?? []).filter((i) => i.type === "text").map((i) => i.text).join("\n");
      const turn = { id: newId("turn"), items: [], status: "inProgress", error: null };
      // Registered before the reply, so an interrupt that arrives before the
      // turn's first event still finds it.
      running.set(turn.id, { interrupted: false, wake: () => {} });
      reply({ turn });
      // After the reply, as the real server does.
      setTimeout(() => runTurn(p.threadId, thread.cwd, turn, text), 0);
      return;
    }
    case "turn/steer": {
      const ctl = running.get(p.expectedTurnId);
      if (!ctl) return fail(`no running turn ${p.expectedTurnId} to steer`);
      const steered = (p.input ?? []).filter((i) => i.type === "text").map((i) => i.text).join("\n");
      if (dir) appendFileSync(`${dir}/steer-inputs.jsonl`, `${JSON.stringify({ threadId: p.threadId, turnId: p.expectedTurnId, input: p.input })}\n`);
      (ctl.steered ??= []).push(steered);
      return reply({ turnId: p.expectedTurnId });
    }
    case "turn/interrupt": {
      const ctl = running.get(p.turnId);
      if (!ctl) return fail(`no running turn ${p.turnId}`);
      reply({});
      ctl.interrupted = true;
      ctl.wake();
      return;
    }
    case "mcpServerStatus/list": {
      const { tools } = await rpc("tools/list");
      const oauthOk = state && existsSync(`${state}/mcp-oauth-ok`);
      const okFor = (name) => state && existsSync(`${state}/mcp-oauth-ok-${name}`);
      const data = [
        { name: "chart", runtimeStatus: null, pluginId: null, httpOrigin: null, tools: Object.fromEntries(tools.map((t) => [t.name, t])), toolsError: null, authStatus: "unsupported" },
        {
          name: "fake-oauth",
          runtimeStatus: null,
          pluginId: null,
          httpOrigin: "https://mcp.fake-oauth.example",
          tools: oauthOk ? { lookup: { name: "lookup", inputSchema: { type: "object" } } } : {},
          toolsError: oauthOk ? null : "Auth required",
          authStatus: oauthOk ? "oAuth" : "notLoggedIn",
        },
        ...addedServers().map((a) => ({
          name: a.name,
          runtimeStatus: null,
          pluginId: null,
          httpOrigin: new URL(a.url).origin,
          tools: okFor(a.name) ? { search: { name: "search", inputSchema: { type: "object" } } } : {},
          toolsError: okFor(a.name) ? null : "Auth required",
          authStatus: okFor(a.name) ? "oAuth" : "notLoggedIn",
        })),
      ].filter((s) => !p.serverName || s.name === p.serverName);
      return reply({ data, nextCursor: null });
    }
    case "app/list":
      return reply({
        data: [{ id: "github", name: "GitHub", description: null, isAccessible: false, isEnabled: true, installUrl: "https://chatgpt.com/apps/github" }],
        nextCursor: null,
      });
    case "mcpServer/oauth/login": {
      if (p.name !== "fake-oauth" && !addedServers().some((a) => a.name === p.name)) return fail(`${p.name} does not use OAuth`);
      const loginId = newId("mcp-login");
      const server = Bun.serve({
        port: 0,
        hostname: "127.0.0.1",
        fetch(req) {
          const url = new URL(req.url);
          if (url.pathname !== "/callback" || !url.searchParams.get("code")) return new Response("bad", { status: 400 });
          log(`mcp oauth callback code=${url.searchParams.get("code")}`);
          if (state) writeFileSync(p.name === "fake-oauth" ? `${state}/mcp-oauth-ok` : `${state}/mcp-oauth-ok-${p.name}`, "");
          setTimeout(() => {
            server.stop();
            notify("mcpServer/oauthLogin/completed", { name: p.name, threadId: null, loginId, success: true });
          }, 50);
          return new Response("Signed in. You can close this tab.");
        },
      });
      const redirect = `http://127.0.0.1:${server.port}/callback`;
      return reply({ authorizationUrl: `https://auth.fake-oauth.example/authorize?state=s1&redirect_uri=${encodeURIComponent(redirect)}`, loginId });
    }
    case "config/mcpServer/reload":
      return reply({});
    case "config/read":
      if (dir && existsSync(`${dir}/config-read.json`)) return reply({ config: JSON.parse(readFileSync(`${dir}/config-read.json`, "utf8")), origins: {}, layers: null });
      return reply({ config: { mcp_servers: Object.fromEntries(addedServers().map((a) => [a.name, { url: a.url }])) }, origins: {}, layers: null });
    case "config/value/write": {
      const m = /^mcp_servers\.([A-Za-z0-9_-]+)$/.exec(p.keyPath ?? "");
      if (!m) return fail(`fake codex: cannot write ${p.keyPath}`);
      const rest = addedServers().filter((a) => a.name !== m[1]);
      saveServers(p.value === null ? rest : [...rest, { name: m[1], url: p.value.url }]);
      log(`config write ${p.keyPath} ${JSON.stringify(p.value)}`);
      return reply({ status: "ok", version: "fake", filePath: mcpFile, overriddenMetadata: null });
    }
    case "mcpServer/resource/read": {
      if (p.server !== "chart") return fail(`no server ${p.server}`);
      const read = await rpc("resources/read", { uri: p.uri });
      return reply({ contents: read.contents, originCallId: p.originCallId ?? null });
    }
    case "mcpServer/tool/call": {
      if (p.server !== "chart") return fail(`no server ${p.server}`);
      if (dir) appendFileSync(`${dir}/mcp-calls.jsonl`, `${JSON.stringify({ threadId: p.threadId, tool: p.tool, arguments: p.arguments })}\n`);
      return reply(await rpc("tools/call", { name: p.tool, arguments: p.arguments ?? {} }));
    }
    default:
      return fail(`fake codex does not implement ${method}`);
  }
}

// An agent's session hands the engine a preamble, then the user's message.
// Only what the user typed controls the scripted behaviour.
const AGENT_MARK = "\nThe user's message:\n";
const typed = (text) => (text.includes(AGENT_MARK) ? text.slice(text.lastIndexOf(AGENT_MARK) + AGENT_MARK.length) : text);

async function runTurn(threadId, cwd, turn, text) {
  // Retrieved records may contain markers from other sessions. Only this
  // question controls the scripted engine's behavior.
  const behaviorText = typed(text);
  const turnId = turn.id;
  const item = (method, it) => notify(method, { threadId, turnId, item: it, startedAtMs: 0, completedAtMs: 0 });
  const finish = (status, error = null) => {
    running.delete(turnId);
    notify("turn/completed", { threadId, turn: { ...turn, status, error } });
  };
  const say = (answer, chunks) => {
    const itemId = newId("msg");
    for (const chunk of chunks) notify("item/agentMessage/delta", { threadId, turnId, itemId, delta: chunk });
    item("item/completed", { type: "agentMessage", id: itemId, text: answer });
  };

  notify("turn/started", { threadId, turn });

  // Session naming, before any marker: its prompt quotes the conversation.
  // A title when the conversation has "[name]", none otherwise; "[name-fail]"
  // fails the turn, so the namer falls back to Claude.
  if (text.startsWith("Name this coding session")) {
    if (text.includes("[name-fail]")) return finish("failed", { message: "scripted naming failure" });
    const title = text.includes("[name]") ? '"Fake named session."' : "";
    say(title, [title]);
    return finish("completed");
  }

  const calls = toolMarkers(behaviorText);
  if (calls.length) {
    const items = calls.map((c) => ({ type: "mcpToolCall", id: newId("mcp"), server: "switchyard", tool: c.tool, arguments: c.args, appContext: null, mcpAppUi: null, pluginId: null }));
    for (const it of items) item("item/started", { ...it, status: "inProgress", result: null, error: null });
    const results = await callTools(threads.get(threadId)?.tools, calls);
    results.forEach((r, i) =>
      item("item/completed", { ...items[i], status: "completed", result: { content: [{ type: "text", text: r.text }], structuredContent: null, _meta: null, isError: r.isError }, error: null, durationMs: 5 }),
    );
    const answer = afterCalls(results);
    say(answer, [answer]);
    return finish("completed");
  }

  if (behaviorText.includes("[subagent]")) {
    const child = newId("agent");
    const activity = { type: "subAgentActivity", agentThreadId: child, agentPath: "reviewer", model: "fake-fast" };
    const spawn = {
      type: "collabAgentToolCall", id: newId("call"), tool: "spawnAgent", status: "completed",
      prompt: "TEST-check the migration", receiverThreadIds: [child], agentsStates: { [child]: { status: "running" } },
    };
    item("item/completed", spawn);
    item("item/completed", { ...activity, id: newId("activity"), kind: "started" });
    item("item/completed", { ...activity, id: newId("activity"), kind: "completed" });
    item("item/completed", {
      ...spawn, id: newId("call"), tool: "wait", prompt: null,
      agentsStates: { [child]: { status: "completed", message: "TEST-Codex subagent report" } },
    });
    return finish("completed");
  }

  if (behaviorText.includes("[stuck]")) {
    notify("item/agentMessage/delta", { threadId, turnId, itemId: newId("msg"), delta: "Stuck" });
    return;
  }

  if (behaviorText.includes("[slow]")) {
    const itemId = newId("msg");
    const ctl = running.get(turnId);
    notify("item/agentMessage/delta", { threadId, turnId, itemId, delta: "Working" });
    if (!ctl.interrupted) await new Promise((resolve) => (ctl.wake = resolve));
    return finish("interrupted");
  }

  if (behaviorText.includes("[tail]")) {
    const ctl = running.get(turnId);
    const itemId = newId("cmd");
    const base = { type: "commandExecution", id: itemId, command: "/bin/bash -lc 'echo tail'", cwd, commandActions: [] };
    item("item/started", { ...base, status: "inProgress" });
    item("item/completed", { ...base, status: "completed", exitCode: 0, aggregatedOutput: "tail\n" });
    await new Promise((r) => setTimeout(r, 1000));
    if (ctl.interrupted) return finish("interrupted");
    const answer = `Echo: ${text}`;
    say(answer, [answer]);
    return finish("completed");
  }

  if (behaviorText.includes("[steps]")) {
    const ctl = running.get(turnId);
    for (let i = 1; i <= 3; i++) {
      const itemId = newId("cmd");
      const command = `/bin/bash -lc 'echo step ${i}'`;
      const base = { type: "commandExecution", id: itemId, command, cwd, commandActions: [] };
      item("item/started", { ...base, status: "inProgress" });
      await new Promise((r) => setTimeout(r, 400));
      item("item/completed", { ...base, status: "completed", exitCode: 0, aggregatedOutput: `step ${i}\n` });
      if (ctl.interrupted) return finish("interrupted");
    }
    const steered = ctl.steered?.length ? ` | steered: ${ctl.steered.join(" / ")}` : "";
    const answer = `Echo: ${text}${steered}`;
    say(answer, [answer]);
    return finish("completed");
  }

  if (behaviorText.includes("[chart]")) {
    const itemId = newId("mcp");
    const args = { metric: "p95 latency", points: 8 };
    const base = { type: "mcpToolCall", id: itemId, server: "chart", tool: "show_chart", arguments: args, appContext: null, mcpAppUi: { resourceUri: CHART_URI, preferredModelDisplayMode: "inline" }, pluginId: null, readOnlyHint: true };
    item("item/started", { ...base, status: "inProgress", result: null, error: null });
    const { result } = await chartCall(args);
    item("item/completed", { ...base, status: "completed", result: { content: result.content, structuredContent: result.structuredContent, _meta: null }, error: null, durationMs: 5 });
    say("Here is the chart.", ["Here is the chart."]);
    return finish("completed");
  }

  if (behaviorText.includes("[context]")) {
    return finish("failed", { message: "Codex ran out of room in the model's context window. Start a new thread.", codexErrorInfo: "contextWindowExceeded", additionalDetails: null });
  }

  if (behaviorText.includes("[fail]")) {
    return finish("failed", { message: "fake failure: the model is unavailable", codexErrorInfo: null, additionalDetails: null });
  }

  if (behaviorText.includes("[think]")) {
    const itemId = newId("reasoning");
    item("item/started", { type: "reasoning", id: itemId, summary: [], content: [] });
    notify("item/reasoning/summaryPartAdded", { threadId, turnId, itemId, summaryIndex: 0 });
    notify("item/reasoning/summaryTextDelta", { threadId, turnId, itemId, summaryIndex: 0, delta: "Reading " });
    notify("item/reasoning/summaryTextDelta", { threadId, turnId, itemId, summaryIndex: 0, delta: "the tests" });
    notify("item/reasoning/summaryPartAdded", { threadId, turnId, itemId, summaryIndex: 1 });
    notify("item/reasoning/summaryTextDelta", { threadId, turnId, itemId, summaryIndex: 1, delta: "Then the fix" });
    item("item/completed", { type: "reasoning", id: itemId, summary: ["Reading the tests", "Then the fix"], content: [] });
    say("Thought it through.", ["Thought it through."]);
    return finish("completed");
  }

  if (behaviorText.includes("[cmd]")) {
    const itemId = newId("cmd");
    const command = "/bin/bash -lc 'echo approved'";
    const base = { type: "commandExecution", id: itemId, command, cwd, commandActions: [] };
    item("item/started", { ...base, status: "inProgress" });
    const answer = await ask("item/commandExecution/requestApproval", {
      threadId,
      turnId,
      itemId,
      startedAtMs: 0,
      command,
      cwd,
      reason: "needs to run a command",
    });
    const decision = answer?.result?.decision;
    if (decision === "accept" || decision === "acceptForSession") {
      item("item/completed", { ...base, status: "completed", exitCode: 0, aggregatedOutput: "approved\n" });
      // A real agent keeps working after a command, so input steered in
      // meanwhile lands in this turn; the answer names it.
      await new Promise((r) => setTimeout(r, 400));
      const steered = running.get(turnId)?.steered;
      const answer = steered?.length ? `Ran it. | steered: ${steered.join(" / ")}` : "Ran it.";
      say(answer, answer === "Ran it." ? ["Ran ", "it."] : [answer]);
    } else {
      item("item/completed", { ...base, status: "declined", exitCode: null, aggregatedOutput: null });
      say("Skipped it.", ["Skipped it."]);
    }
    return finish("completed");
  }

  if (behaviorText.includes("[edit]")) {
    const itemId = newId("edit");
    const changes = [
      {
        path: `${cwd.replace(/\/$/, "")}/src/lib.rs`,
        kind: { type: "update", move_path: null },
        diff: "@@ -1 +1,2 @@\n fn kept() {}\n+fn added() {}\n",
      },
    ];
    item("item/started", { type: "fileChange", id: itemId, changes, status: "inProgress" });
    if (process.env.FAKE_CODEX_WRITE) {
      mkdirSync(`${cwd.replace(/\/$/, "")}/src`, { recursive: true });
      writeFileSync(changes[0].path, "fn kept() {}\nfn added() {}\n");
    }
    item("item/completed", { type: "fileChange", id: itemId, changes, status: "completed" });
    say("Edited src/lib.rs.", ["Edited ", "src/lib.rs."]);
    return finish("completed");
  }

  const answer = `Echo: ${typed(text)}`;
  const third = Math.ceil(answer.length / 3);
  say(answer, [answer.slice(0, third), answer.slice(third, 2 * third), answer.slice(2 * third)]);
  finish("completed");
}

function onLine(line) {
  if (!line.trim()) return;
  let msg;
  try {
    msg = JSON.parse(line);
  } catch {
    return;
  }
  if (msg.method === undefined && msg.id !== undefined) {
    // The client's answer to one of our requests.
    const resolve = waiting.get(msg.id);
    waiting.delete(msg.id);
    resolve?.(msg);
    return;
  }
  if (msg.id === undefined) return; // a notification, such as `initialized`
  handle(msg).catch((e) => write({ id: msg.id, error: { code: -32603, message: String(e) } }));
}

// yardd owns our stdin: when it closes (yardd stopped or was killed), exit,
// even in the middle of a slow turn.
for await (const line of console) onLine(line);
log(`exit pid=${process.pid}`);
process.exit(0);
