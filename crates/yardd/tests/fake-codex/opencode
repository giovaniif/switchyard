#!/usr/bin/env bun
// A scripted stand-in for the `opencode` CLI, for yardd's tests and
// verify/yv's isolated environments. No turn reaches a model.
//
//   opencode acp                 the ACP agent in acp-agent.mjs
//   opencode models [--verbose]  "opencode/fake-free", plus "fakeprov/fake-pro"
//                                (efforts low and high) once fakeprov is logged in
//   opencode serve ...           the provider login endpoints yardd uses:
//                                GET /provider, GET /provider/auth, PUT /auth/:id,
//                                POST /provider/:id/oauth/{authorize,callback}
//
// Logins are saved per account: under XDG_DATA_HOME (an added account's
// folder) or else FAKE_CODEX_DIR/opencode-default, as `connected.json`, the
// provider ids only. `fakeauth` signs in two ways: method 0 shows a link and
// takes the code "good-code"; method 1 shows a device code and finishes by
// itself after 2.5 s.

import { existsSync, mkdirSync, readFileSync, writeFileSync, appendFileSync } from "node:fs";
import { runAgent } from "./acp-agent.mjs";

const dir = process.env.FAKE_CODEX_DIR ?? "/tmp";
const state = process.env.XDG_DATA_HOME ? `${process.env.XDG_DATA_HOME}/opencode` : `${dir}/opencode-default`;
const account = process.env.XDG_DATA_HOME ? process.env.XDG_DATA_HOME.split("/").pop() : "default";
mkdirSync(state, { recursive: true });
const connectedFile = `${state}/connected.json`;
const connected = () => (existsSync(connectedFile) ? JSON.parse(readFileSync(connectedFile, "utf8")) : []);
const connect = (id) => writeFileSync(connectedFile, JSON.stringify([...new Set([...connected(), id])]));
const log = (line) => appendFileSync(`${dir}/opencode.log`, `${line}\n`);

const args = process.argv.slice(2);
const v2 = process.env.YARD_TEST_OPENCODE_V2 === "1";
log(`run ${args.join(" ")} account=${account}`);

if (args[0] === "--version") {
  console.log(v2 ? "opencode v2.4.2" : "0.0.0-fake");
} else if (args[0] === "acp") {
  runAgent({ engine: "opencode", state, account, loggedIn: () => true });
} else if (args[0] === "models") {
  if (v2) {
    if (args.includes("--verbose")) {
      console.error("Unrecognized flag: --verbose in command opencode models");
      process.exit(1);
    }
    console.log("opencode/fake-free\nopencode-go/fake-go");
    process.exit(0);
  }
  const models = [["opencode/fake-free", { name: "Fake Free", variants: {} }]];
  if (connected().includes("fakeprov")) models.push(["fakeprov/fake-pro", { name: "Fake Pro", variants: { low: {}, high: {} } }]);
  for (const [id, m] of models) {
    console.log(id);
    if (args.includes("--verbose")) console.log(JSON.stringify(m, null, 2));
  }
} else if (args[0] === "serve") {
  const port = Number(args[args.indexOf("--port") + 1]);
  const expected = "Basic " + Buffer.from(`${process.env.OPENCODE_SERVER_USERNAME ?? "opencode"}:${process.env.OPENCODE_SERVER_PASSWORD ?? ""}`).toString("base64");
  const json = (v, status = 200) => new Response(JSON.stringify(v), { status, headers: { "content-type": "application/json" } });
  Bun.serve({
    hostname: "127.0.0.1",
    port,
    async fetch(req) {
      if (process.env.OPENCODE_SERVER_PASSWORD && req.headers.get("authorization") !== expected) return new Response("no", { status: 401 });
      const url = new URL(req.url);
      const path = url.pathname;
      log(`http ${req.method} ${path}`);
      if (path === "/provider") {
        return json({
          all: [
            { id: "opencode", name: "OpenCode Zen" },
            { id: "fakeprov", name: "Fake Provider" },
            { id: "fakeauth", name: "Fake Sign-in" },
          ],
          connected: ["opencode", ...connected()],
          default: {},
        });
      }
      if (path === "/provider/auth") {
        return json({ fakeauth: [{ type: "oauth", label: "Sign in with a code" }, { type: "oauth", label: "Device code" }] });
      }
      const body = req.method === "GET" ? {} : await req.json();
      let m;
      if (req.method === "PUT" && (m = path.match(/^\/auth\/([^/]+)$/))) {
        // Only that a key arrived is kept, never the key.
        if (body.type !== "api" || !body.key) return json({ message: "missing key" }, 400);
        connect(m[1]);
        return json(true);
      }
      if ((m = path.match(/^\/provider\/([^/]+)\/oauth\/authorize$/))) {
        if (body.method === 0) return json({ url: "https://fake.example/oauth?state=x", method: "code", instructions: "Paste the code the page shows" });
        return json({ url: "https://fake.example/device", method: "auto", instructions: "Enter code: FAKE-4321" });
      }
      if ((m = path.match(/^\/provider\/([^/]+)\/oauth\/callback$/))) {
        if (body.method === 0 && body.code !== "good-code") return json({ message: "That code was not accepted" }, 400);
        // Slow enough to see the device code, as a person would.
        if (body.method === 1) await Bun.sleep(2500);
        connect(m[1]);
        return json(true);
      }
      return json({ message: "not found" }, 404);
    },
  });
} else {
  console.error(`fake opencode: ${args.join(" ")} is not implemented`);
  process.exit(2);
}
