#!/usr/bin/env bun
// A fake remote MCP server that signs in with OAuth, for verify/yv: what a
// connector Switchyard holds itself (for OpenCode, Grok and Gemini) talks to.
// Nothing leaves the machine. Add it on the Connectors page as
// http://127.0.0.1:<port>/mcp.
//
//   mcp-oauth [--port N] [--port-file F]   prints {"port":N} when listening
//
// OAuth: protected-resource and authorization-server metadata, dynamic client
// registration (/register), /authorize (redirects straight back to the
// client's redirect_uri with a code and the state: there is no page to click
// through), /token (authorization_code with PKCE S256, and refresh_token).
// MCP (/mcp, Streamable HTTP, plain JSON answers): 401 without a token it
// issued; initialize, tools/list (two tools) and tools/call.
//
// GET /state lists what it saw, never a token: registrations, authorizations
// and the MCP methods called.
import { createHash, randomBytes } from "node:crypto";
import { writeFileSync } from "node:fs";

const arg = (name: string) => {
  const i = process.argv.indexOf(name);
  return i > 0 ? process.argv[i + 1] : undefined;
};

const codes = new Map<string, { challenge: string; client: string }>();
const access = new Set<string>();
const refresh = new Set<string>();
const seen = { registrations: 0, authorizations: 0, calls: [] as string[] };
const token = () => randomBytes(24).toString("hex");
const json = (body: unknown, status = 200, headers: Record<string, string> = {}) =>
  new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json", ...headers } });

const TOOLS = [
  { name: "list_issues", description: "TEST: list issues", inputSchema: { type: "object", properties: {} }, annotations: { readOnlyHint: true } },
  { name: "get_issue", description: "TEST: read one issue", inputSchema: { type: "object", properties: { id: { type: "string" } }, required: ["id"] }, annotations: { readOnlyHint: true } },
];

const server = Bun.serve({
  hostname: "127.0.0.1",
  port: Number(arg("--port") ?? 0),
  async fetch(req) {
    const url = new URL(req.url);
    const base = `http://127.0.0.1:${server.port}`;
    if (url.pathname.startsWith("/.well-known/oauth-protected-resource")) {
      return json({ resource: `${base}/mcp`, authorization_servers: [base], scopes_supported: ["read"] });
    }
    if (url.pathname.startsWith("/.well-known/oauth-authorization-server")) {
      return json({
        issuer: base,
        authorization_endpoint: `${base}/authorize`,
        token_endpoint: `${base}/token`,
        registration_endpoint: `${base}/register`,
        code_challenge_methods_supported: ["S256"],
        grant_types_supported: ["authorization_code", "refresh_token"],
      });
    }
    if (url.pathname === "/register" && req.method === "POST") {
      seen.registrations++;
      const body = await req.json().catch(() => ({}));
      return json({ client_id: `TEST-client-${seen.registrations}`, redirect_uris: body.redirect_uris ?? [], token_endpoint_auth_method: "none" }, 201);
    }
    if (url.pathname === "/authorize") {
      const q = url.searchParams;
      const back = q.get("redirect_uri");
      if (!back || q.get("code_challenge_method") !== "S256" || !q.get("code_challenge") || !q.get("state")) return json({ error: "invalid_request" }, 400);
      seen.authorizations++;
      const code = token();
      codes.set(code, { challenge: q.get("code_challenge")!, client: q.get("client_id") ?? "" });
      const to = new URL(back);
      to.searchParams.set("code", code);
      to.searchParams.set("state", q.get("state")!);
      return Response.redirect(to.toString(), 302);
    }
    if (url.pathname === "/token" && req.method === "POST") {
      const form = new URLSearchParams(await req.text());
      const issue = () => {
        const a = token();
        const r = token();
        access.add(a);
        refresh.add(r);
        return json({ access_token: a, refresh_token: r, token_type: "Bearer", expires_in: 3600 });
      };
      if (form.get("grant_type") === "authorization_code") {
        const pending = codes.get(form.get("code") ?? "");
        codes.delete(form.get("code") ?? "");
        const proved = createHash("sha256").update(form.get("code_verifier") ?? "").digest("base64url");
        if (!pending || proved !== pending.challenge) return json({ error: "invalid_grant" }, 400);
        return issue();
      }
      if (form.get("grant_type") === "refresh_token" && refresh.delete(form.get("refresh_token") ?? "")) return issue();
      return json({ error: "invalid_grant" }, 400);
    }
    if (url.pathname === "/mcp") {
      const bearer = req.headers.get("authorization")?.replace(/^Bearer /, "") ?? "";
      if (!access.has(bearer)) {
        return json({ error: "unauthorized" }, 401, { "www-authenticate": `Bearer resource_metadata="${base}/.well-known/oauth-protected-resource/mcp"` });
      }
      if (req.method !== "POST") return new Response(null, { status: 405 });
      const msg = await req.json().catch(() => null);
      if (!msg || typeof msg.method !== "string") return json({ error: "expected JSON-RPC" }, 400);
      seen.calls.push(msg.method);
      if (msg.id == null) return new Response(null, { status: 202 });
      const answer = (result: unknown) => json({ jsonrpc: "2.0", id: msg.id, result });
      if (msg.method === "initialize") {
        return answer({ protocolVersion: msg.params?.protocolVersion ?? "2025-06-18", capabilities: { tools: {} }, serverInfo: { name: "TEST-oauth", version: "0" } });
      }
      if (msg.method === "tools/list") return answer({ tools: TOOLS });
      if (msg.method === "tools/call") return answer({ content: [{ type: "text", text: `TEST: ${msg.params?.name} ran` }] });
      return json({ jsonrpc: "2.0", id: msg.id, error: { code: -32601, message: "Method not found" } });
    }
    if (url.pathname === "/state") return json(seen);
    return json({ error: "not found" }, 404);
  },
});

const portFile = arg("--port-file");
if (portFile) writeFileSync(portFile, String(server.port));
console.log(JSON.stringify({ port: server.port }));
