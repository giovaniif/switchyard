#!/usr/bin/env bun
// A fake Slack for tests and verify/yv: the Web API methods yardd's slack.rs
// calls, and Socket Mode's WebSocket. Nothing leaves the machine. Point yardd
// at it with YARD_SLACK_API=http://127.0.0.1:<port>/api/.
//
//   fake-slack [--port N] [--port-file F]   prints {"port":N} when listening
//
// The workspace is TEST-workspace (T0TEST); the bot is @switchyard (UBOT,
// BBOT). Users: UOWNER "TEST-Owner", USTRANGER "TEST-Stranger", any other id
// "TEST-<id>". Channels: C0GENERAL #general, C0OPS #ops, C0DEV #dev, C0INCIDENT
// #incidents; a D… id is a DM.
// A token containing "bad" is refused (invalid_auth).
//
// Web API (form or JSON bodies, bearer token): auth.test,
// apps.connections.open, chat.postMessage, chat.postEphemeral, reactions.add,
// reactions.remove, users.info, conversations.info. Every call is recorded
// with its token's kind (bot, app), never the token.
// Each post also records which bot made it (`app`: agent or shared).
//
// Socket Mode (/socket): sends hello on connect, records every ack.
//
// An agent's own app (slack.rs `slack.grant` and `slack.app.*`): a
// configuration refresh token is any `xoxe-…` without "bad";
// tooling.tokens.rotate turns it into `xoxe.xoxp-1-TEST`, which
// apps.manifest.create (recorded under `manifests`) and apps.manifest.delete
// take. oauth.v2.access takes code TEST-code with client secret TEST-secret
// and installs it for UOWNER: its bot token `xoxb-agent-TEST` is @agent
// (UAGENT), and an app-level token with "agent" in it opens a socket of its
// own. A message's `app` ("agent" or "shared") picks the socket it goes down;
// without one, every socket gets it. apps.manifest.update is recorded under
// `updates`; apps.icon.set (multipart, like Slack's) under `icons` with the
// PNG's size, never its bytes. The app's signing secret is
// TEST-signing-secret: /_fake/event signs with it.
//
// The owner's own app (slack.rs `slack.me.*`): a manifest with user scopes
// and no bot user is made as A0YOU (client C0YOU); oauth.v2.access for it
// installs a user token `xoxp-you-TEST` for UOWNER (@test-owner), with no bot
// token. Its app-level token has "you" in it and opens the `you` socket. A
// user token works for auth.test, users.info and conversations.info.
//
// The owner's own DMs (his user token): users.conversations lists D0ANA (a DM
// with UANA "TEST-Ana": two messages 70-80 days old, three in the last days,
// one with a thread reply; read up to two days ago, so one is unread),
// G0TRIO (a group DM with Ana and the stranger, one unread message 5 days old) and
// D0QUIET (a DM with UOLD whose only message is 100 days old). His channels:
// C0GENERAL #general (two messages in the last days) and G0PRIV
// #secret-plans (private, one message); users.conversations lists them for
// types public_channel / private_channel.
// conversations.history (oldest, latest, limit, cursor; top-level messages,
// newest first), conversations.replies, conversations.members and
// conversations.info (`last_read`) read them. A message sent to the `you`
// socket (`app: "you"`) is added to its conversation (a new D… id becomes a DM
// with its sender) with a real-time ts. POST /_fake/raw {app, event} sends one
// event as it is (an edit, a deletion, a reaction).
//
// Control, for tests:
//   POST /_fake/message {user, text, channel?, thread_ts?, bot_id?, subtype?, mention?,
//                        username?, bot_profile?, attachments?, blocks?}
//        Slack's events for a message: in a DM `message` (channel_type im);
//        in a channel `message`, plus `app_mention` when the text mentions
//        <@UBOT> (as Slack sends both). `user: null` leaves the user out, as
//        an integration's `bot_message` does. Answers {ts, envelopes}.
//   POST /_fake/disconnect {reason?}   a `disconnect` envelope, then a close
//   POST /_fake/drop                   closes every socket at once
//   POST /_fake/event {url, user, text, channel?, thread_ts?, sign?, retry?, event_id?}
//        Slack's Events API instead of Socket Mode: the same events for a
//        message to the agent's app, POSTed to `url` (yardd's /slack/events)
//        and signed (`sign`: good, the default; bad; stale, 10 minutes old;
//        none). `retry` sends X-Slack-Retry-Num and reuses `event_id`.
//        Answers {ts, results: [{status, body}]}.
//   POST /_fake/challenge {url, sign?}  Slack's url_verification of `url`
//   POST /_fake/lapse                  the configuration tokens given so far stop working
//   GET  /_fake/state                  {connections, opens, acks, calls, posts, ephemerals, reactions, manifests, updates, icons, deleted, marks}
// The owner's posts (his user token: chat.postMessage, reactions, conversations.mark)
// are recorded too, posts with `app: "you"`.

const args = process.argv.slice(2);
const arg = (name) => {
  const i = args.indexOf(`--${name}`);
  return i >= 0 ? args[i + 1] : undefined;
};

const BOT = "UBOT";
const AGENT_BOT = "UAGENT";
const USERS = { UOWNER: "TEST-Owner", USTRANGER: "TEST-Stranger", UANA: "TEST-Ana", UOLD: "TEST-Old" };
const CHANNELS = { C0GENERAL: "general", C0OPS: "ops", C0DEV: "dev", C0INCIDENT: "incidents" };

let clock = 1_700_000_000;
const nextTs = () => `${++clock}.000100`;
let envelopeN = 0;

import { createHmac } from "node:crypto";

const SIGNING_SECRET = "TEST-signing-secret";
const state = { opens: 0, acks: [], calls: [], posts: [], ephemerals: [], reactions: {}, manifests: [], updates: [], icons: [], deleted: [] };
// Configuration tokens: each rotation hands out the next; /_fake/lapse
// refuses every one handed out before it, as when a token goes unused.
let issued = 0;
let lapsedUpTo = 0;
const lapsed = (token) => {
  const n = Number((token ?? "").match(/-(\d+)$/)?.[1] ?? 0);
  return n > 0 && n <= lapsedUpTo;
};
const sockets = new Set();

// The owner's own conversations, with real-time timestamps.
let realN = 0;
const realTs = (secondsAgo = 0) => `${Math.floor(Date.now() / 1000) - secondsAgo}.${String(++realN).padStart(6, "0")}`;
const DAY = 86400;
const inbox = {
  D0ANA: { kind: "im", user: "UANA", members: ["UOWNER", "UANA"], messages: [] },
  G0TRIO: { kind: "mpim", name: "mpdm-test-ana--test-stranger--test-owner-1", members: ["UOWNER", "UANA", "USTRANGER"], messages: [] },
  D0QUIET: { kind: "im", user: "UOLD", members: ["UOWNER", "UOLD"], messages: [] },
  C0GENERAL: { kind: "channel", name: "general", members: ["UOWNER", "UANA", "USTRANGER"], messages: [] },
  G0PRIV: { kind: "group", name: "secret-plans", members: ["UOWNER", "UANA"], messages: [] },
};
{
  const ana = inbox.D0ANA.messages;
  ana.push({ type: "message", user: "UANA", text: "TEST-old news", ts: realTs(80 * DAY) });
  ana.push({ type: "message", user: "UANA", text: "TEST-older still", ts: realTs(70 * DAY) });
  ana.push({ type: "message", user: "UANA", text: "TEST-are you around? *bold* <https://example.com|a link>", ts: realTs(3 * DAY) });
  const yes = { type: "message", user: "UOWNER", text: "TEST-yes, <@UANA>", ts: realTs(2 * DAY) };
  ana.push(yes);
  inbox.D0ANA.last_read = yes.ts;
  const lunch = { type: "message", user: "UANA", text: "TEST-lunch tomorrow?", ts: realTs(DAY), reply_count: 1, reactions: [{ name: "thumbsup", users: ["UOWNER"], count: 1 }] };
  ana.push(lunch);
  ana.push({ type: "message", user: "UOWNER", text: "TEST-sure, noon", ts: realTs(DAY - 60), thread_ts: lunch.ts });
  lunch.thread_ts = lunch.ts;
  inbox.G0TRIO.messages.push({ type: "message", user: "USTRANGER", text: "TEST-hello all", ts: realTs(5 * DAY) });
  inbox.G0TRIO.last_read = "1000000000.000000";
  inbox.D0QUIET.messages.push({ type: "message", user: "UOLD", text: "TEST-ancient", ts: realTs(100 * DAY) });
  inbox.C0GENERAL.messages.push({ type: "message", user: "USTRANGER", text: "TEST-standup in 5", ts: realTs(2 * DAY) });
  inbox.C0GENERAL.messages.push({ type: "message", user: "UANA", text: "TEST-shipping today", ts: realTs(DAY) });
  inbox.G0PRIV.messages.push({ type: "message", user: "UANA", text: "TEST-the secret plan", ts: realTs(3 * DAY) });
}
const topLevel = (m) => !m.thread_ts || m.thread_ts === m.ts || m.subtype === "thread_broadcast";

const tokenKind = (auth) => {
  const token = (auth || "").replace(/^Bearer\s+/i, "");
  if (token.startsWith("xoxb-")) return "bot";
  if (token.startsWith("xoxe.xoxp-")) return "config";
  if (token.startsWith("xoxp-")) return "user";
  if (token.startsWith("xapp-")) return "app";
  return token ? "other" : "none";
};

async function params(req) {
  const type = req.headers.get("content-type") || "";
  const out = Object.fromEntries(new URL(req.url).searchParams);
  if (req.method !== "POST") return out;
  if (type.includes("multipart/form-data")) {
    const form = await req.formData();
    for (const [k, v] of form.entries()) {
      if (typeof v === "string") out[k] = v;
      else {
        const bytes = new Uint8Array(await v.arrayBuffer());
        const png = bytes.length >= 24 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47;
        const side = (at) => new DataView(bytes.buffer, bytes.byteOffset).getUint32(at);
        out[k] = { file: v.name ?? "", type: v.type, size: bytes.length, png, width: png ? side(16) : 0, height: png ? side(20) : 0 };
      }
    }
    return out;
  }
  const body = await req.text();
  if (type.includes("json")) return { ...out, ...JSON.parse(body || "{}") };
  return { ...out, ...Object.fromEntries(new URLSearchParams(body)) };
}

function api(method, p, auth, port) {
  const kind = tokenKind(auth);
  const token = (auth || "").replace(/^Bearer\s+/i, "");
  const refused = { ok: false, error: kind === "none" ? "not_authed" : "invalid_auth" };
  switch (method) {
    case "auth.test":
      if (kind === "user" && !token.includes("bad")) return { ok: true, url: "https://test-workspace.slack.com/", team: "TEST-workspace", user: "test-owner", team_id: "T0TEST", user_id: "UOWNER" };
      if (kind !== "bot" || token.includes("bad")) return refused;
      if (token.includes("agent")) return { ok: true, url: "https://test-workspace.slack.com/", team: "TEST-workspace", user: "agent", team_id: "T0TEST", user_id: AGENT_BOT, bot_id: "BAGENT" };
      return { ok: true, url: "https://test-workspace.slack.com/", team: "TEST-workspace", user: "switchyard", team_id: "T0TEST", user_id: BOT, bot_id: "BBOT" };
    case "apps.connections.open":
      if (kind !== "app" || token.includes("bad")) return refused;
      state.opens++;
      return { ok: true, url: `ws://127.0.0.1:${port}/socket?ticket=TEST-ticket-${state.opens}&app=${token.includes("agent") ? "agent" : token.includes("you") ? "you" : "shared"}` };
    case "tooling.tokens.rotate": {
      if (!(p.refresh_token ?? "").startsWith("xoxe-") || p.refresh_token.includes("bad") || lapsed(p.refresh_token)) return { ok: false, error: "invalid_refresh_token" };
      // Already expired (clock is in 2023): yardd rotates before each use.
      const n = ++issued;
      return { ok: true, token: `xoxe.xoxp-1-TEST-${n}`, refresh_token: `xoxe-1-TEST-next-${n}`, team_id: "T0TEST", user_id: "UOWNER", iat: clock, exp: clock + 43200 };
    }
    case "apps.manifest.create": {
      if (kind !== "config" || lapsed(token)) return refused;
      const manifest = JSON.parse(p.manifest ?? "{}");
      state.manifests.push(manifest);
      if (manifest.oauth_config?.scopes?.user && !manifest.features?.bot_user) {
        const scopes = manifest.oauth_config.scopes.user.join(",");
        return { ok: true, app_id: "A0YOU", credentials: { client_id: "C0YOU", client_secret: "TEST-secret", verification_token: "v", signing_secret: SIGNING_SECRET }, oauth_authorize_url: `https://slack.test/oauth/v2/authorize?client_id=C0YOU&scope=&user_scope=${scopes}` };
      }
      return { ok: true, app_id: "A0AGENT", credentials: { client_id: "C0AGENT", client_secret: "TEST-secret", verification_token: "v", signing_secret: SIGNING_SECRET }, oauth_authorize_url: "https://slack.test/oauth/v2/authorize?client_id=C0AGENT&scope=app_mentions:read,chat:write" };
    }
    case "apps.manifest.update": {
      if (kind !== "config" || lapsed(token)) return { ok: false, error: kind === "config" ? "token_expired" : refused.error };
      if (!p.app_id) return { ok: false, error: "invalid_app_id" };
      state.updates.push({ app_id: p.app_id, manifest: JSON.parse(p.manifest ?? "{}") });
      return { ok: true, app_id: p.app_id, permissions_updated: false };
    }
    case "apps.icon.set": {
      if (kind !== "config" || lapsed(token)) return { ok: false, error: kind === "config" ? "token_expired" : refused.error };
      if (!p.app_id) return { ok: false, error: "invalid_app_id" };
      if (!p.file || typeof p.file !== "object") return { ok: false, error: "missing_arguments" };
      if (!p.file.png) return { ok: false, error: "error_bad_format" };
      if (p.file.width < 512 || p.file.height < 512 || p.file.width > 2000 || p.file.height > 2000) return { ok: false, error: "invalid_icon_size" };
      state.icons.push({ app_id: p.app_id, ...p.file });
      return { ok: true };
    }
    case "apps.manifest.delete":
      if (kind !== "config") return refused;
      state.deleted.push(p.app_id);
      return { ok: true };
    case "oauth.v2.access":
      if (p.code !== "TEST-code" || p.client_secret !== "TEST-secret") return { ok: false, error: "invalid_code" };
      if (p.client_id === "C0YOU") return { ok: true, app_id: "A0YOU", team: { id: "T0TEST", name: "TEST-workspace" }, authed_user: { id: "UOWNER", scope: "im:history,im:read", access_token: "xoxp-you-TEST", token_type: "user" } };
      return { ok: true, access_token: "xoxb-agent-TEST", token_type: "bot", bot_user_id: AGENT_BOT, app_id: "A0AGENT", team: { id: "T0TEST", name: "TEST-workspace" }, authed_user: { id: "UOWNER" } };
    case "chat.postMessage": {
      if (kind === "user" && !token.includes("bad")) {
        const c = inbox[p.channel];
        if (!c) return { ok: false, error: "channel_not_found" };
        if (!p.text) return { ok: false, error: "no_text" };
        const ts = realTs();
        const message = { type: "message", user: "UOWNER", text: p.text, ts, ...(p.thread_ts ? { thread_ts: p.thread_ts } : {}) };
        c.messages.push(message);
        state.posts.push({ channel: p.channel, thread_ts: p.thread_ts ?? null, text: p.text, ts, app: "you" });
        return { ok: true, channel: p.channel, ts, message };
      }
      if (kind !== "bot") return refused;
      if (!p.channel) return { ok: false, error: "channel_not_found" };
      if (!p.text) return { ok: false, error: "no_text" };
      const ts = nextTs();
      // Which bot posted: an agent's own (@agent) or the shared one.
      state.posts.push({ channel: p.channel, thread_ts: p.thread_ts ?? null, text: p.text, ts, app: token.includes("agent") ? "agent" : "shared" });
      return { ok: true, channel: p.channel, ts, message: { text: p.text, ts } };
    }
    case "chat.postEphemeral":
      if (kind !== "bot") return refused;
      state.ephemerals.push({ channel: p.channel, user: p.user, text: p.text });
      return { ok: true, message_ts: nextTs() };
    case "conversations.mark":
      if (kind !== "user") return refused;
      (state.marks ??= []).push({ channel: p.channel, ts: p.ts });
      return { ok: true };
    case "reactions.add":
    case "reactions.remove": {
      if (kind !== "bot" && kind !== "user") return refused;
      const list = (state.reactions[p.timestamp] ??= []);
      if (method === "reactions.add") {
        if (list.includes(p.name)) return { ok: false, error: "already_reacted" };
        list.push(p.name);
      } else {
        if (!list.includes(p.name)) return { ok: false, error: "no_reaction" };
        list.splice(list.indexOf(p.name), 1);
      }
      return { ok: true };
    }
    case "users.info": {
      if (kind !== "bot" && kind !== "user") return refused;
      const name = USERS[p.user] ?? `TEST-${p.user}`;
      return { ok: true, user: { id: p.user, name: name.toLowerCase(), real_name: name, profile: { display_name: name, real_name: name } } };
    }
    case "users.conversations": {
      if (kind !== "user") return refused;
      const types = (p.types ?? "public_channel").split(",");
      const want = { im: "im", mpim: "mpim", channel: "public_channel", group: "private_channel" };
      const channels = Object.entries(inbox)
        .filter(([, c]) => types.includes(want[c.kind]))
        .map(([id, c]) => (c.kind === "im" ? { id, is_im: true, user: c.user, is_user_deleted: false } : c.kind === "mpim" ? { id, is_mpim: true, name: c.name } : { id, is_channel: c.kind === "channel", is_group: c.kind === "group", is_private: c.kind === "group", name: c.name }));
      return { ok: true, channels, response_metadata: { next_cursor: "" } };
    }
    case "conversations.history": {
      if (kind !== "user") return refused;
      const c = inbox[p.channel];
      if (!c) return { ok: false, error: "channel_not_found" };
      const limit = Number(p.limit ?? 100);
      const from = Number(p.cursor ?? 0);
      const all = c.messages.filter(topLevel).filter((m) => (!p.oldest || m.ts > p.oldest) && (!p.latest || m.ts < p.latest)).sort((a, b) => (a.ts < b.ts ? 1 : -1));
      const page = all.slice(from, from + limit);
      const more = from + limit < all.length;
      return { ok: true, messages: page, has_more: more, response_metadata: { next_cursor: more ? String(from + limit) : "" } };
    }
    case "conversations.replies": {
      if (kind !== "user") return refused;
      const c = inbox[p.channel];
      if (!c) return { ok: false, error: "channel_not_found" };
      const messages = c.messages.filter((m) => m.ts === p.ts || m.thread_ts === p.ts).sort((a, b) => (a.ts < b.ts ? -1 : 1));
      return { ok: true, messages, has_more: false };
    }
    case "conversations.members": {
      if (kind !== "user") return refused;
      const c = inbox[p.channel];
      return c ? { ok: true, members: c.members, response_metadata: { next_cursor: "" } } : { ok: false, error: "channel_not_found" };
    }
    case "conversations.info": {
      if (kind === "user" && inbox[p.channel]) {
        const c = inbox[p.channel];
        const last_read = c.last_read ?? "0000000000.000000";
        if (c.kind === "im") return { ok: true, channel: { id: p.channel, is_im: true, user: c.user, last_read } };
        if (c.kind === "mpim") return { ok: true, channel: { id: p.channel, is_mpim: true, name: c.name, last_read } };
        return { ok: true, channel: { id: p.channel, is_channel: c.kind === "channel", is_private: c.kind === "group", name: c.name, last_read } };
      }
      if (kind !== "bot" && kind !== "user") return refused;
      const id = p.channel ?? "";
      if (id.startsWith("D")) return { ok: true, channel: { id, is_im: true, user: "UOWNER" } };
      return { ok: true, channel: { id, name: CHANNELS[id] ?? id.toLowerCase(), is_channel: true } };
    }
    default:
      return { ok: false, error: "unknown_method" };
  }
}

function send(envelope, app) {
  const text = JSON.stringify(envelope);
  for (const ws of sockets) if (!app || ws.data?.app === app) ws.send(text);
}

function eventsFor(p) {
  const channel = p.channel ?? "D0OWNER";
  const ts = p.ts ?? (p.app === "you" ? realTs() : nextTs());
  const im = channel.startsWith("D");
  const base = { user: p.user ?? "UOWNER", text: p.text ?? "", channel, ts, event_ts: ts, team: "T0TEST" };
  // An integration's post (`subtype: bot_message`) often has no user at all.
  if (p.user === null) delete base.user;
  if (p.thread_ts) base.thread_ts = p.thread_ts;
  for (const k of ["bot_id", "subtype", "username", "bot_profile", "attachments", "blocks"]) if (p[k]) base[k] = p[k];
  const list = [{ ...base, type: "message", channel_type: p.channel_type ?? (im ? "im" : channel.startsWith("G") ? "group" : "channel") }];
  if (!im && (base.text.includes(`<@${BOT}>`) || base.text.includes(`<@${AGENT_BOT}>`))) list.unshift({ ...base, type: "app_mention" });
  return { ts, list };
}

function events(p) {
  const { ts, list } = eventsFor(p);
  if (p.app === "you") {
    const c = (inbox[list[0].channel] ??= { kind: "im", user: list[0].user, members: ["UOWNER", list[0].user], messages: [] });
    const { type, channel_type, event_ts, team, ...m } = list[list.length - 1];
    c.messages.push({ type: "message", ...m });
  }
  const envelopes = list.map((event) => {
    const id = `TEST-env-${++envelopeN}`;
    send({ envelope_id: id, type: "events_api", accepts_response_payload: false, retry_attempt: 0, retry_reason: "", payload: { type: "event_callback", team_id: "T0TEST", api_app_id: "A0TEST", event, event_id: `Ev${envelopeN}`, event_time: clock } }, p.app);
    return id;
  });
  return { ts, envelopes };
}

/** One request as Slack's Events API sends it, signed as asked. */
async function deliver(url, body, sign = "good", retry) {
  const now = Math.floor(Date.now() / 1000);
  const ts = String(sign === "stale" ? now - 600 : now);
  const secret = sign === "bad" ? "TEST-wrong-secret" : SIGNING_SECRET;
  const headers = { "content-type": "application/json", "x-slack-request-timestamp": ts };
  if (sign !== "none") headers["x-slack-signature"] = "v0=" + createHmac("sha256", secret).update(`v0:${ts}:${body}`).digest("hex");
  if (retry) {
    headers["x-slack-retry-num"] = String(retry);
    headers["x-slack-retry-reason"] = "http_timeout";
  }
  try {
    const res = await fetch(url, { method: "POST", headers, body });
    return { status: res.status, body: await res.text() };
  } catch (e) {
    return { status: 0, body: String(e) };
  }
}

async function httpEvents(p) {
  const { ts, list } = eventsFor(p);
  const results = [];
  for (const event of list) {
    const id = p.event_id ? `${p.event_id}${list.length > 1 ? `-${event.type}` : ""}` : `EvHTTP${++envelopeN}`;
    const body = JSON.stringify({ token: "v", team_id: "T0TEST", api_app_id: "A0AGENT", event, type: "event_callback", event_id: id, event_time: clock, authorizations: [{ team_id: "T0TEST", user_id: AGENT_BOT, is_bot: true }] });
    results.push({ event_id: id, ...(await deliver(p.url, body, p.sign, p.retry)) });
  }
  return { ts, results };
}

const json = (v, status = 200) => new Response(JSON.stringify(v), { status, headers: { "content-type": "application/json" } });

const server = Bun.serve({
  hostname: "127.0.0.1",
  port: Number(arg("port") ?? 0),
  async fetch(req, srv) {
    const url = new URL(req.url);
    if (url.pathname === "/socket") {
      if (srv.upgrade(req, { data: { app: url.searchParams.get("app") ?? "shared" } })) return;
      return new Response("upgrade required", { status: 426 });
    }
    if (url.pathname.startsWith("/api/")) {
      const method = url.pathname.slice(5);
      const p = await params(req);
      const auth = req.headers.get("authorization");
      state.calls.push({ method, token: tokenKind(auth), params: p, at: Date.now() });
      return json(api(method, p, auth, server.port));
    }
    if (url.pathname === "/_fake/message" && req.method === "POST") return json(events(await req.json()));
    if (url.pathname === "/_fake/raw" && req.method === "POST") {
      const p = await req.json();
      const id = `TEST-env-${++envelopeN}`;
      send({ envelope_id: id, type: "events_api", accepts_response_payload: false, retry_attempt: 0, retry_reason: "", payload: { type: "event_callback", team_id: "T0TEST", api_app_id: "A0TEST", event: p.event, event_id: `Ev${envelopeN}`, event_time: clock } }, p.app);
      return json({ envelope: id });
    }
    if (url.pathname === "/_fake/event" && req.method === "POST") return json(await httpEvents(await req.json()));
    if (url.pathname === "/_fake/challenge" && req.method === "POST") {
      const p = await req.json();
      return json(await deliver(p.url, JSON.stringify({ token: "v", challenge: "TEST-challenge-3eZbrw1aBm2rZgRNFdxV2595E9CY3gmdALWMmHkvFXO7tYXAYM8P", type: "url_verification" }), p.sign));
    }
    if (url.pathname === "/_fake/lapse" && req.method === "POST") {
      lapsedUpTo = issued;
      return json({ ok: true, lapsed: issued });
    }
    if (url.pathname === "/_fake/disconnect" && req.method === "POST") {
      const body = await req.json().catch(() => ({}));
      send({ type: "disconnect", reason: body.reason ?? "refresh_requested", debug_info: { host: "TEST" } });
      // Only these: the client may already have opened its next one.
      const old = [...sockets];
      setTimeout(() => old.forEach((ws) => ws.close()), 50);
      return json({ ok: true, connections: sockets.size });
    }
    if (url.pathname === "/_fake/drop" && req.method === "POST") {
      const n = sockets.size;
      sockets.forEach((ws) => ws.terminate?.() ?? ws.close());
      return json({ ok: true, dropped: n });
    }
    if (url.pathname === "/_fake/state") return json({ connections: sockets.size, ...state });
    return new Response("not found", { status: 404 });
  },
  websocket: {
    open(ws) {
      sockets.add(ws);
      ws.send(JSON.stringify({ type: "hello", num_connections: sockets.size, connection_info: { app_id: "A0TEST" }, debug_info: { host: "TEST" } }));
    },
    message(ws, data) {
      try {
        const msg = JSON.parse(String(data));
        if (msg.envelope_id) state.acks.push(msg.envelope_id);
      } catch {}
    },
    close(ws) {
      sockets.delete(ws);
    },
  },
});

